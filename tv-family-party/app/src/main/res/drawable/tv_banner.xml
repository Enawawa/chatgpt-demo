                android:width="110dp"
                android:height="62dp" />
            <solid android:color="#3D8BFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:gravity="center_vertical|start"
        android:left="42dp">
        <shape android:shape="rectangle">
            <size
                android:width="74dp"
                android:height="14dp" />
            <solid android:color="#F5F8FF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</layer-list>

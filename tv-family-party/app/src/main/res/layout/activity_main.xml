<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="28dp">

    <LinearLayout
        android:id="@+id/startContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/startTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_title"
            android:textColor="@color/text_primary"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/startSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/start_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="360dp"
            android:layout_height="72dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/tv_button_bg"
            android:text="@string/start_game"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <Button
            android:id="@+id/rulesButton"
            android:layout_width="360dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/tv_button_bg"
            android:text="@string/show_rules"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gameContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/roundText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/teamTurnText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/questionText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:background="@drawable/tv_button_bg_normal"
            android:gravity="center"
            android:padding="22dp"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/optionRow1"
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/optionA"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <Button
                android:id="@+id/optionB"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionRow2"
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/optionC"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <Button
                android:id="@+id/optionD"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_bg"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="22sp" />

        <Button
            android:id="@+id/continueButton"
            android:layout_width="260dp"
            android:layout_height="68dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/tv_button_bg"
            android:text="@string/continue_text"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/hint_text"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result_title"
            android:textColor="@color/text_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/text_secondary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/resultScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_primary"
            android:textSize="26sp" />

        <Button
            android:id="@+id/playAgainButton"
            android:layout_width="320dp"
            android:layout_height="72dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/tv_button_bg"
            android:text="@string/play_again"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />
    </LinearLayout>

</FrameLayout>
